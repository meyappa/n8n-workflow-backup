    \"Content-Type\": \"application/json\"\n}\n\nitem = items[0]\njson_data = item.get(\"json\", {})\n\nchat_id = json_data.get(\"old_chat_id\")\nmessage_id = json_data.get(\"old_message_id\")\n\npayload = {\n    \"chat_id\": chat_id,\n    \"message_id\": message_id\n}\n\nresponse = requests.post(\n    f\"{SUPABASE_URL}/rest/v1/telegram_messages\",\n    headers=headers,\n    json=payload\n)\n\nreturn [{\n    \"status\": \"stored_in_supabase\",\n    \"chat_id\": chat_id,\n    \"message_id\": message_id,\n    \"supabase_response\": response.json()\n}]\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2128,704],"id":"20c78538-14ab-4c5d-aa9c-6e2398e69a4e","name":"set old_message_id"},{"parameters":{"tableId":"telegram_messages","fieldsUi":{"fieldValues":[{"fieldId":"message_id","fieldValue":"={{ $json.result.message_id }}"},{"fieldId":"chat_id","fieldValue":"={{ $json.result.chat.id }}"},{"fieldId":"status","fieldValue":"OPEN"}]}},"type":"n8n-nodes-base.supabase","typeVersion":1,"position":[2528,288],"id":"c7f78ee9-a2a5-4245-9083-8767caaf2f51","name":"Create a row","credentials":{"supabaseApi":{"id":"YbwXd6E3gVBSNjUW","name":"Supabase account"}}},{"parameters":{"height":384,"width":848,"color":3},"type":"n8n-nodes-base.stickyNote","position":[2064,528],"typeVersion":1,"id":"5320f2c5-9407-45cf-8f50-242028600b11","name":"Sticky Note3"},{"parameters":{"language":"python","pythonCode":"import requests\nimport os\n\n# Your Supabase info\nSUPABASE_URL = \"https://wtswzrnwsstjwesavnvu.supabase.co\"\nSUPABASE_KEY = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind0c3d6cm53c3N0andlc2F2bnZ1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTI4MTE2MzEsImV4cCI6MjA2ODM4NzYzMX0.tzbT6d6NPmKCVHVBO4Vl_pcRSsOwy4lXM7QKa18IKzI\"\n\nheaders = {\n    \"apikey\": SUPABASE_KEY,\n    \"Authorization\": f\"Bearer {SUPABASE_KEY}\"\n}\n\n# Get most recent message\nresponse = requests.get(\n    f\"{SUPABASE_URL}/rest/v1/telegram_messages?order=inserted_at.desc&limit=1\",\n    headers=headers\n)\n\ndata = response.json()\nif data:\n    chat_id = data[0][\"chat_id\"]\n    message_id = data[0][\"message_id\"]\nelse:\n    chat_id = None\n    message_id = None\n\nreturn [{\n    \"chat_id\": chat_id,\n    \"message_id\": message_id\n}]\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2704,704],"id":"7a49311a-ce5c-4b39-95e3-e06416d38a07","name":"Retrive the old messsage id"},{"parameters":{"jsCode":"// Config\nSUPABASE_URL = \"https://wtswzrnwsstjwesavnvu.supabase.co\"\nSUPABASE_KEY = \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind0c3d6cm53c3N0andlc2F2bnZ1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTI4MTE2MzEsImV4cCI6MjA2ODM4NzYzMX0.tzbT6d6NPmKCVHVBO4Vl_pcRSsOwy4lXM7QKa18IKzI\"\n\nconst TELEGRAM_BOT_TOKEN = \"8467923623:AAHDcHEX-TO_cJZTpoOj__P0XGihFcL5JHc\";\n\n// 1️⃣ Get latest chat_id & message_id from Supabase\nconst latest = await this.helpers.httpRequest({\n  method: 'GET',\n  url: `${SUPABASE_URL}/rest/v1/telegram_messages`,\n  qs: {\n    order: 'inserted_at.desc',\n    limit: 1\n  },\n  headers: {\n    apikey: SUPABASE_KEY,\n    Authorization: `Bearer ${SUPABASE_KEY}`,\n  },\n  json: true\n});\n\nif (!latest.length) {\n  return [{ status: \"no data in Supabase\" }];\n}\n\nconst { chat_id, message_id } = latest[0];\n\n// 2️⃣ Delete the message from Telegram\nconst tgDelete = await this.helpers.httpRequest({\n  method: 'GET',\n  url: `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/deleteMessage`,\n  qs: {\n    chat_id,\n    message_id\n  },\n  json: true\n});\n\n// 3️⃣ Return output\nreturn [\n  {\n    status: \"deleted\",\n    chat_id,\n    message_id,\n    telegram_response: tgDelete\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[3136,-48],"id":"dc6b4053-219f-46e3-9ff0-69c8ce36117f","name":"Delete Old Message"},{"parameters":{"resource":"speech","operation":"speechToText","additionalOptions":{},"requestOptions":{}},"type":"@elevenlabs/n8n-nodes-elevenlabs.elevenLabs","typeVersion":1,"posi